# Copy to .env and fill in. Never commit .env.

# --- Storage ---------------------------------------------------------------
# "memory" = numpy index persisted to .cache/index.json (no Docker needed)
# "postgres" = Postgres + pgvector (docker compose up -d)
STORE_BACKEND=memory
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage

# --- Embeddings ------------------------------------------------------------
# "fastembed" = local BAAI/bge-small-en-v1.5 via ONNX (downloads ~130 MB once)
# "hashing"   = deterministic toy embedder for tests; no download, poor quality
EMBEDDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Generation ------------------------------------------------------------
# "gemini" needs GEMINI_API_KEY; "fake" returns canned output (tests/offline UI)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# "openai_compat": any OpenAI-compatible API. Free and local with Ollama (no key):
#   LLM_PROVIDER=openai_compat  OPENAI_MODEL=qwen2.5:3b
# Groq / OpenRouter: set OPENAI_BASE_URL and OPENAI_API_KEY.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen2.5:3b
OPENAI_JSON_MODE=json_schema

# --- Retrieval / agent limits ---------------------------------------------
TOP_K=5
RETRIEVAL_MODE=hybrid
AGENT_MAX_STEPS=4
AGENT_MAX_QUERY_REWRITES=1

# --- Integrations (docs/integrations.md); each endpoint is off until set ---
WEBHOOK_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
INTEGRATION_MODE=rag

# --- Reviewer feedback (docs/feedback.md); stores incident text ------------
FEEDBACK_ENABLED=true
FEEDBACK_DB_PATH=.cache/feedback.sqlite3
